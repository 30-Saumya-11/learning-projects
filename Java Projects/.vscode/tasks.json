{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Current Java File",
            "type": "shell",
            "command": "javac",
            "args": [
                "-source",
                "8",
                "-target",
                "8",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$javac"]
        },
        {
            "label": "Compile All Java Files",
            "type": "shell",
            "command": "javac",
            "args": [
                "-source",
                "8",
                "-target",
                "8",
                "*.java"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$javac"]
        },
        {
            "label": "Run HelloWorld",
            "type": "shell",
            "command": "java",
            "args": ["HelloWorld"],
            "group": "test",
            "dependsOn": "Compile Current Java File",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Run StarPyramid",
            "type": "shell",
            "command": "java",
            "args": ["StarPyramid"],
            "group": "test",
            "dependsOn": "Compile Current Java File",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Run PalindromeChecker",
            "type": "shell",
            "command": "java",
            "args": ["PalindromeChecker"],
            "group": "test",
            "dependsOn": "Compile Current Java File",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Run PalindromeTest",
            "type": "shell",
            "command": "java",
            "args": ["PalindromeTest"],
            "group": "test",
            "dependsOn": "Compile Current Java File",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
} 